#!/usr/bin/env bash

# ======================
# Check IPSL-AID installation
# ======================
if ! command -v ipsl-aid &> /dev/null; then
    echo "ERROR: ipsl-aid command not found. Please install the package first using: uv pip install -e ."
    echo "       or activate the virtual environment if already installed using: source .venv/bin/activate"
    exit 1
fi

# ======================
# 0. Machine Selection
# ======================
# Uncomment the machine you're using:
MACHINE="DALIA"        # on Dalia
#MACHINE="LEONARDO"    # on LEONARDO
#MACHINE="HAL"         # on HAL

# ======================
# Machine-specific configurations
# ======================
if [ "$MACHINE" == "DALIA" ]; then
    # Dalia-specific settings
    SLURM_ACCOUNT=""  # No account needed on Dalia
    SLURM_PARTITION=""  # No partition specified for Dalia
    SLURM_QOS=""
    SLURM_GRES=1
    SLURM_NODES=1
    SLURM_NTASKS_PER_NODE=1
    SLURM_CPUS_PER_TASK=36
    SLURM_TIME="12:00:00"
    SLURM_DEBUG_TIME="00:30:00"

    # Dalia-specific training parameters
    BATCH_SIZE=64     # Maximum batch size for Dalia (1 GPU)
    NUM_WORKERS=0     # Workers per GPU

    # Environment activation for Dalia
    ENV_ACTIVATE_CMD="source /lustre/work/pdl18162/udl8a60dc/miniforge3/etc/profile.d/conda.sh && conda activate ipsl-aid"
    MODULE_LOAD_CMD="module load gcc/14.2.0 && module load slurm/slurm/24.11 && module load cuda13.1/toolkit"
    # Data paths for Dalia
    datadir="/lustre/work/pdl18162/udl8a60dc/data_ST_sliced"
    per_var_datadir=(
      "VAR_ST=/lustre/work/pdl18162/udl8a60dc/data_ST_sliced"
    )
    dynamic_covariates_dir="../data_covariates/"
    constant_varnames_file="/lustre/work/pdl18162/udl8a60dc/data_ST_sliced/ESA_constants_sliced.nc"

elif [ "$MACHINE" == "LEONARDO" ]; then
    # LEONARDO-specific settings
    SLURM_ACCOUNT="EUHPC_D27_095"
    SLURM_PARTITION="boost_usr_prod"
    SLURM_QOS="boost_qos_bprod"
    SLURM_GRES=4
    SLURM_NODES=1
    SLURM_NTASKS_PER_NODE=1
    SLURM_CPUS_PER_TASK=16
    SLURM_TIME="24:00:00"
    SLURM_DEBUG_TIME="00:30:00"

    # LEONARDO-specific training parameters
    BATCH_SIZE=18      # Maximum batch size for LEONARDO (1 GPU)
    NUM_WORKERS=16     # Workers per GPU

    # Environment activation for LEONARDO
    ENV_ACTIVATE_CMD="source $PROJECT_ROOT/.venv/bin/activate"
    MODULE_LOAD_CMD=""

    # Data paths for LEONARDO
    datadir="/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily"
    per_var_datadir=(
      "VAR_2T=/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily"
      "VAR_10U=/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily"
      "VAR_10V=/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily"
      "VAR_TP=/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily_tp"
      "VAR_D2M=/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily_d2m_sstk"
      "VAR_ST=/leonardo_work/EUHPC_D27_095/kkingston/AI-Downscaling/data/data_FOURxDaily_st"
    )
    dynamic_covariates_dir="../data_covariates/"

elif [ "$MACHINE" == "HAL" ]; then
    # HAL-specific settings
    SLURM_ACCOUNT=""
    SLURM_PARTITION="batch"
    SLURM_QOS=""
    SLURM_GRES=1
    SLURM_NODES=1
    SLURM_NTASKS_PER_NODE=1
    SLURM_CPUS_PER_TASK=4
    SLURM_TIME="24:00:00"
    SLURM_DEBUG_TIME="00:30:00"

    # HAL-specific training parameters
    BATCH_SIZE=4       # Maximum batch size for HAL (1 GPU)
    NUM_WORKERS=4      # Workers per GPU

    # Environment activation for HAL
    ENV_ACTIVATE_CMD="source $PROJECT_ROOT/.venv/bin/activate"
    MODULE_LOAD_CMD=""
    # Data paths for HAL
    datadir="/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large"
    per_var_datadir=(
      "VAR_2T=/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large"
      "VAR_10U=/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large"
      "VAR_10V=/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large"
      "VAR_TP=/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large_tp"
      "VAR_D2M=/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large_d2m_sstk"
      "VAR_ST=/net/nfs/ssd1/kardaneh/Data_LSM_1995-2000_Large_st"
    )
    dynamic_covariates_dir="../data_covariates/"
else
    echo "ERROR: Unknown machine: $MACHINE"
    echo "Please set MACHINE to: DALIA, LEONARDO, or HAL"
    exit 1
fi

# ======================
# 1. Unified Debug Flag
# ======================
debug=false     # true = SLURM debug job + Python --debug true,  Note: Avoid True (use true instead)
                # false = full job + Python --debug false, Note: Avoid False (use false instead)

DATE=$(date +"%Y%m%d")
TODAY=$(date +"%Y%m%d_%H%M%S")

# ======================
# 2. Parameters
# ======================

run_type="train" # "train", ""train_regional"

region="Europe" # Only for run_type="train_regional"
region_size=("288" "720") # Only for run_type="train_regional"

coarse_input_shape=("42" "60")  # Coarse resolution used for down/up sampling "80" "128"

overlap_ratio=0.0 # 0.02 during inference

save_model=true
save_checkpoint_name="sst_unet_model"
load_checkpoint_name="sst_unet_model"
save_per_samples=10000

year_start=2015
year_end=2019
year_start_test=2020 #2020
year_end_test=2020 #2020

batch_size=$BATCH_SIZE
num_workers=$NUM_WORKERS

num_epochs=40
learning_rate=0.0001

per_var_coarse_datadir=()

time_normalization="cos_sin"

varnames_list=("VAR_ST")
constant_varnames_list=("lsm")

normalization_types=("VAR_2T=standard")
units_list=("K")
dynamic_covariates=()

sbatch=20 #12 # 60 percent of the total blocks ot the domain
tbatch=1800
batch_size_lat=120
batch_size_lon=240

epsilon=0.02
beta=1.0
margin=8

pretrained_path=""
model_name=""

dtype="fp32"
arch="ddpmpp" # options are "ddpmpp", "ncsnpp", and "adm"

embedding_type="positional"
encoder_type="standard"
decoder_type="standard"
resample_filter=(1 1)
channel_mult_noise=1

# Set architecture-specific defaults
if [[ "$arch" == "adm" ]]; then
    model_channels=128
    channel_mult=(1 2 3 4)
    num_blocks=2
    attn_resolutions=(32 16 8)
elif [[ "$arch" == "ddpmpp" ]]; then
    model_channels=128
    channel_mult=(2 2 2)
    num_blocks=2
    attn_resolutions=(16)
elif [[ "$arch" == "ncsnpp" ]]; then
    model_channels=128
    channel_mult=(2 2 2)
    num_blocks=4
    attn_resolutions=(16)
    embedding_type="fourier"
    encoder_type="residual"
    decoder_type="standard"
    resample_filter=(1 3 3 1)
    channel_mult_noise=2
fi

# Dropout is the same for all
dropout=0.10

precond="unet" # edm for edm (default model), unet for unet,
# for diffusion in_channels = numbers of variables, for unet in_channels = numbers of variables + constants

model_constant_channels=${#constant_varnames_list[@]}
model_input_channels=$((${#varnames_list[@]} + 2 + model_constant_channels))

if [[ "$precond" == "unet" ]]; then
    in_channels=$model_input_channels
    cond_channels=""   # no cond_channels for unet
else  # for diffusion-based arch
    in_channels=${#varnames_list[@]}
    cond_channels=$model_input_channels
fi

out_channels=1 # number of variables
inference_type="direct" # "direct" for unet, "sampler" for diffusion

compute_crps=false

if [[ "$compute_crps" == true && "$inference_type" != "sampler" ]]; then
    echo "WARNING: CRPS requires sampler inference. Disabling compute_crps."
    compute_crps=false
fi

# EDM Sampler Parameters
num_steps=10
sigma_min=0.002
sigma_max=80.0
rho=7
s_churn=40
solver="heun"


# Add apply_filter parameter
apply_filter=false

# ======================
# Generate Tag and Output Paths
# ======================
eps_str="${epsilon//./d}"
lr_str="${learning_rate//./d}"

mode_str=$([[ "$debug" == true ]] && echo "debug" || echo "prod")

# Create BASE model name parts (configuration only)
base_parts=("y${year_start}_${year_end}")
base_parts+=("norm_${time_normalization}")
base_parts+=("lat${batch_size_lat}")
base_parts+=("lon${batch_size_lon}")
base_parts+=("vars${#varnames_list[@]}")
base_parts+=("coarse${coarse_input_shape[0]}x${coarse_input_shape[1]}")
base_parts+=("dt${dtype}")
base_parts+=("arch${arch}")
base_parts+=("pre${precond}")
base_parts+=("in${in_channels}")

# Add network architecture parameters to base_parts
base_parts+=("ch${model_channels}")
base_parts+=("mult$(IFS=_ ; echo "${channel_mult[*]}")")
base_parts+=("blocks${num_blocks}")
base_parts+=("attn$(IFS=_ ; echo "${attn_resolutions[*]}")")
base_parts+=("drop${dropout//./d}")
# Only add these for non-ADM architectures
#if [[ "$arch" != "adm" ]]; then
#    base_parts+=("emb${embedding_type}")
#    base_parts+=("enc${encoder_type}")
#    base_parts+=("dec${decoder_type}")
#    base_parts+=("filter$(IFS=_ ; echo "${resample_filter[*]}")")
#    base_parts+=("noise${channel_mult_noise}")
#fi

if [[ "$precond" == "edm" ]]; then
    base_parts+=("cond${cond_channels}")
fi

base_parts+=("out${out_channels}")
filter_str=$([[ "$apply_filter" == true ]] && echo "filter" || echo "nofilter")
base_parts+=("${filter_str}")

# Create TRAINING model name parts (training-specific)
train_parts=("ep${num_epochs}")
train_parts+=("sb${sbatch}")
train_parts+=("tb${tbatch}")
train_parts+=("eps${eps_str}")
train_parts+=("mrg${margin}")
train_parts+=("inf_${inference_type}")

sigma_min_str="${sigma_min//./d}"
sigma_max_str="${sigma_max//./d}"
rho_str="${rho//./d}"

if [[ "$inference_type" == "sampler" ]]; then
    train_parts+=("steps${num_steps}")
    train_parts+=("sigmin${sigma_min_str}")
    train_parts+=("sigmax${sigma_max_str}")
    train_parts+=("rho${rho_str}")
    train_parts+=("s_churn${s_churn}")
    train_parts+=("solver_${solver}")
fi

# Add checkpoint info to model name if not training from scratch
if [[ "$run_type" == "resume_train" || "$run_type" == "inference" ]]; then
    train_parts+=("resume")
fi

# Combine all parts
model_parts=("${mode_str}" "${base_parts[@]}" "${train_parts[@]}")

# Model name (full configuration) - PROPERLY joined with underscores
model_name=$(IFS=_ ; echo "${model_parts[*]}")
tag="${model_name}_bs${batch_size}_lr${lr_str}_${TODAY}"

# Define output paths - hierarchical structure
# Main folder: mode + base configuration - PROPERLY joined
main_folder="${mode_str}_$(IFS=_ ; echo "${base_parts[*]}")"

# Sub folder: training parameters + date - PROPERLY joined
train_parts_str=$(IFS=_ ; echo "${train_parts[*]}")
sub_folder="train_${train_parts_str}_bs${batch_size}_lr${lr_str}"

# Prefix: simple run identifier
prefix="run_${TODAY}"

# ======================
# Generate SBATCH Script Only (removed run script)
# ======================
PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
sbatch_script="$PROJECT_ROOT/slurm/sbatch_${save_checkpoint_name}_${main_folder}_${sub_folder}.sh"

# Create slurm_io directory if it doesn't exist
mkdir -p "$PROJECT_ROOT/slurm_io"

# ======================
# Generate SBATCH Script
# ======================

cat > $sbatch_script <<EOF
#!/bin/bash
#SBATCH --job-name=${save_checkpoint_name}_${tag}
EOF

# Add account only if set
if [ -n "$SLURM_ACCOUNT" ]; then
    echo "#SBATCH --account=$SLURM_ACCOUNT" >> $sbatch_script
fi

# Add partition only if set
if [ -n "$SLURM_PARTITION" ]; then
    echo "#SBATCH --partition=$SLURM_PARTITION" >> $sbatch_script
fi

# SLURM debug selection
if [ "$debug" = true ]; then
    echo "#SBATCH --time=$SLURM_DEBUG_TIME" >> $sbatch_script
    if [ -n "$SLURM_QOS" ] && [ "$Machine" == "LEONARDO" ]; then
        echo "#SBATCH --qos=boost_qos_dbg" >> $sbatch_script
    fi
else
    echo "#SBATCH --time=$SLURM_TIME" >> $sbatch_script
fi


cat >> $sbatch_script <<EOF
#SBATCH --nodes=$SLURM_NODES
#SBATCH --gpus-per-node=$SLURM_GRES
#SBATCH --ntasks-per-node=$SLURM_NTASKS_PER_NODE
#SBATCH --cpus-per-task=$SLURM_CPUS_PER_TASK
EOF

# Add --mem-per-gpu only for non-Dalia machines
if [ "$MACHINE" != "DALIA" ]; then
    echo "#SBATCH --mem-per-gpu=64G" >> $sbatch_script
fi

cat >> $sbatch_script <<EOF
#SBATCH --error=$PROJECT_ROOT/slurm_io/${save_checkpoint_name}_${tag}_%j.err
#SBATCH --output=$PROJECT_ROOT/slurm_io/${save_checkpoint_name}_${tag}_%j.out

ulimit -s unlimited
module purge

# Load modules if needed
$MODULE_LOAD_CMD

# Activate environment
$ENV_ACTIVATE_CMD

export PYTHONUNBUFFERED=1

echo "=========================================="
echo "CONFIGURATION TEST VALUES"
echo "=========================================="
echo "Machine: $MACHINE"
echo "ntasks-per-node: $SLURM_NTASKS_PER_NODE"
echo "cpus-per-task: $SLURM_CPUS_PER_TASK"
echo "num_workers: $num_workers"
echo "=========================================="
echo ""
echo "=== Job Info ==="
echo "Debug mode: $debug"
echo "Apply filter: $apply_filter"
echo "In shape / coarse resolution: ${in_shape[@]}"
echo "Inference type: $inference_type"
echo "Node list: \${SLURM_NODELIST}"
echo "Job ID: \${SLURM_JOB_ID}"
echo "Current dir: \$(pwd)"
echo "Output main folder: $main_folder"
echo "Output sub folder: $sub_folder"
echo "=========================================="
echo ""
echo "=== Environment Info ==="
echo "Python: \$(which python)"
echo "Python version: \$(python --version 2>&1)"
echo "PyTorch version: \$(python -c 'import torch; print(torch.__version__)' 2>/dev/null || echo 'Not installed')"
echo "CUDA available: \$(python -c 'import torch; print(torch.cuda.is_available())' 2>/dev/null || echo 'False')"
echo "CUDA version: \$(python -c 'import torch; print(torch.version.cuda)' 2>/dev/null || echo 'N/A')"
echo "GPU count: \$(python -c 'import torch; print(torch.cuda.device_count())' 2>/dev/null || echo '0')"
if python -c "import torch" 2>/dev/null && [ "\$(python -c 'import torch; print(torch.cuda.is_available())' 2>/dev/null)" == "True" ]; then
    echo "GPU names: \$(python -c 'import torch; print(torch.cuda.get_device_name(0))' 2>/dev/null || echo 'Unknown')"
    echo "GPU memory: \$(python -c 'import torch; print(f\"{torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")' 2>/dev/null || echo 'Unknown')"
fi
echo ""
echo "=== IPSL-AID Training ==="
echo "Start time: \$(date)"

# Use ipsl-aid command directly
ipsl-aid \\
    --debug $debug \\
    --main_folder "$main_folder" \\
    --sub_folder "$sub_folder" \\
    --prefix "$prefix" \\
    --run_type "$run_type" \\
    --save_model $save_model \\
    --save_checkpoint_name "$save_checkpoint_name" \\
    --load_checkpoint_name "$load_checkpoint_name" \\
    --save_per_samples "$save_per_samples" \\
    --inference_type "$inference_type" \\
    --arch "$arch" \\
    --precond "$precond" \\
    --in_channels "$in_channels" \\
    --out_channels "$out_channels" \\
    --apply_filter $apply_filter \\
    --in_shape ${coarse_input_shape[@]} \\
    --overlap_ratio "$overlap_ratio" \\
EOF

# Add cond_channels only for EDM
[[ "$precond" == "edm" ]] && echo "    --cond_channels \"$cond_channels\" \\" >> $sbatch_script

# Add optional parameters
[ -n "$pretrained_path" ] && echo "    --pretrained_path \"$pretrained_path\" \\" >> $sbatch_script
[ -n "$model_name" ] && echo "    --model_name \"$model_name\" \\" >> $sbatch_script

# Regional only
if [[ "$run_type" == "train_regional" || "$run_type" == "inference_regional" ]]; then
    [ -n "$region" ] && echo "    --region \"$region\" \\" >> $sbatch_script
    [ ${#region_size[@]} -gt 0 ] && echo "    --region_size ${region_size[@]} \\" >> $sbatch_script
fi

# Add arrays
[ ${#varnames_list[@]} -gt 0 ] && echo "    --varnames_list ${varnames_list[@]} \\" >> $sbatch_script
[ ${#normalization_types[@]} -gt 0 ] && echo "    --normalization_types ${normalization_types[@]} \\" >> $sbatch_script
[ ${#constant_varnames_list[@]} -gt 0 ] && echo "    --constant_varnames_list ${constant_varnames_list[@]} \\" >> $sbatch_script
echo "    --constant_varnames_file \"$constant_varnames_file\" \\" >> $sbatch_script
[ ${#units_list[@]} -gt 0 ] && echo "    --units_list ${units_list[@]} \\" >> $sbatch_script
[ ${#dynamic_covariates[@]} -gt 0 ] && echo "    --dynamic_covariates ${dynamic_covariates[@]} \\" >> $sbatch_script

cat >> $sbatch_script <<EOF
    --year_start "$year_start" \\
    --year_end "$year_end" \\
    --year_start_test "$year_start_test" \\
    --year_end_test "$year_end_test" \\
    --batch_size "$batch_size" \\
    --num_epochs "$num_epochs" \\
    --learning_rate "$learning_rate" \\
    --num_workers "$num_workers" \\
    --datadir "$datadir" \\
    --per_var_datadir ${per_var_datadir[@]} \\
    --time_normalization "$time_normalization" \\
    --tbatch "$tbatch" \\
    --sbatch "$sbatch" \\
    --batch_size_lat "$batch_size_lat" \\
    --batch_size_lon "$batch_size_lon" \\
    --in_shape ${coarse_input_shape[@]} \\
    --epsilon "$epsilon" \\
    --beta "$beta" \\
    --margin "$margin" \\
    --dynamic_covariates_dir "$dynamic_covariates_dir" \\
    --dtype "$dtype" \\
    --num_steps "$num_steps" \\
    --model_channels "$model_channels" \\
    --channel_mult ${channel_mult[@]} \\
    --num_blocks "$num_blocks" \\
    --attn_resolutions ${attn_resolutions[@]} \\
    --dropout "$dropout" \\
    --embedding_type "$embedding_type" \\
    --encoder_type "$encoder_type" \\
    --decoder_type "$decoder_type" \\
    --resample_filter ${resample_filter[@]} \\
    --channel_mult_noise "$channel_mult_noise" \\
    --sigma_min "$sigma_min" \\
    --sigma_max "$sigma_max" \\
    --rho "$rho" \\
    --s_churn "$s_churn" \\
    --solver "$solver" \\
    --compute_crps "$compute_crps"

exit \$?
EOF

chmod +x $sbatch_script

# ======================
# Final Output
# ======================
echo "=== Setup Complete ==="
echo "Debug mode: $debug"
echo "Apply filter: $apply_filter"
echo "In shape / coarse resolution: ${in_shape[@]}"
echo "Inference type: $inference_type"
echo "Run type: $run_type"
echo "Save model: $save_model"
echo "Load checkpoint: $load_checkpoint_name"
if [[ "$run_type" == "resume_train" || "$run_type" == "inference" ]]; then
    echo "Checkpoint file: $load_checkpoint_name"
fi
echo ""
echo "=== Model Configuration ==="
echo "Architecture: $arch"
echo "Preconditioner: $precond"
echo "Model channels: $model_channels"
echo "Channel multipliers: ${channel_mult[@]}"
echo "Num blocks: $num_blocks"
echo "Attention resolutions: ${attn_resolutions[@]}"
echo "Dropout: $dropout"
echo "Embedding type: $embedding_type"
echo "Encoder type: $encoder_type"
echo "Decoder type: $decoder_type"
echo "Resample filter: ${resample_filter[@]}"
echo "Channel mult noise: $channel_mult_noise"
echo ""
echo "Model name parts: ${model_parts[*]}"
echo "Model name: $model_name"
echo "Tag: $tag"
echo ""
echo "Main folder: $main_folder"
echo "Sub folder: $sub_folder"
echo "Prefix: $prefix"
echo ""
echo "SBATCH script: $sbatch_script"
echo ""
echo "To submit the job:"
echo "  sbatch $sbatch_script"
echo ""
echo "To test locally (small run):"
echo "  source .venv/bin/activate"
echo "  ipsl-aid --debug true --run_type train --num_epochs 1 --batch_size 2"
